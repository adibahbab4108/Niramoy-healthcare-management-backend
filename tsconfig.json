{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",            // include repo root -> prevents TS6059 for prisma.config.ts
    "types": []
  },
  // "include": ["src/**/*", "prisma/**/*"]
}
