model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  name               String?
  password           String
  needPasswordChange Boolean  @default(false)
  role               UserRole @default(PATIENT)
  status             String   @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  admin     Admin?
  doctor    Doctor?
  patient   Patient?

  @@map("users")
}

model Admin {
  id                 String   @id @default(uuid())
  email              String   @unique
  name               String?
  password           String
  needPasswordChange Boolean  @default(false)
  role               UserRole @default(ADMIN)
  status             String   @default("ACTIVE")
  isDeleted          Boolean  @default(false)
  profilePhoto       String?
  contactNumber      String?
  address            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [email], references: [email])

  @@map("admins")
}

model Doctor {
  id                 String   @id @default(uuid())
  email              String   @unique
  name               String?
  password           String
  needPasswordChange Boolean  @default(false)
  role               UserRole @default(DOCTOR)
  status             String   @default("ACTIVE")
  isDeleted          Boolean  @default(false)
  profilePhoto       String?
  contactNumber      String?
  address            String?
  registrationNumber String?
  qualification      String?
  experienceYears    Int?
  gender             Gender
  appointmentFee     Float?
  currentWorkplace   String?
  designation        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [email], references: [email])

  @@map("doctors")
}

model Patient {
  id                 String    @id @default(uuid())
  email              String    @unique
  name               String?
  password           String
  needPasswordChange Boolean   @default(false)
  role               UserRole  @default(PATIENT)
  status             String    @default("ACTIVE")
  isDeleted          Boolean   @default(false)
  profilePhoto       String?
  contactNumber      String?
  address            String?
  dateOfBirth        DateTime?

  user User @relation(fields: [email], references: [email])

  @@map("patients")
}
